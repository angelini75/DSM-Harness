# DSM-Harness .gitignore

# R & RStudio artifacts
.Rhistory
.RData
.Rproj.user/
.Ruserdata/
Rplots.pdf

# Temporary and heavy cache files
terra_tmp/
*.tmp
*.temp

# Heavy raster outputs and model binaries (avoid committing huge files to Git)
03_outputs/module3/tiles/*.tif
03_outputs/module3/maps/*.tif
03_outputs/module3/models/*.rds
!03_outputs/**/.gitkeep

# Cloned scratch repositories (internal references)
scratch/

# User datasets, intermediate files, configurations, logs and reports
01_data/profiles/*
!01_data/profiles/.gitkeep
!01_data/profiles/user_config.template.json
01_data/covariates/*
!01_data/covariates/.gitkeep
!01_data/covariates/README.md
config/user_*
projects/*/data/*
projects/*/outputs/*
projects/*/reports/*
projects/*/covariates/*
projects/*/models/*
!projects/**/.gitkeep

# Global raster and binary models protection (prevent committing heavy outputs)
*.tif
*.tiff
*.rds
!tests/**/fixtures/*.rds
!tests/**/fixtures/*.tif

# OS specific files
Thumbs.db
.DS_Store
desktop.ini

